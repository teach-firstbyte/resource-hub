# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
#
# Rules:
# - List every variable your app needs here, with a fake or empty value.
# - Never put a real secret in this file. It is committed and public.
# - Variables that start with NEXT_PUBLIC_ are sent to the browser. Only use
#   that prefix for values that are safe for anyone to see.

NEXT_PUBLIC_APP_URL=http://localhost:3000
